#!/bin/bash

# Simple HTTP server control script
# Usage: ./server start | stop | restart | status

PORT=8000
PID_FILE=".server.pid"

start_server() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Server is already running on port $PORT (PID: $PID)"
            echo "Visit: http://localhost:$PORT"
            return 1
        else
            # PID file exists but process is not running
            rm "$PID_FILE"
        fi
    fi

    echo "Starting HTTP server on port $PORT..."
    python3 -m http.server $PORT > /dev/null 2>&1 &
    echo $! > "$PID_FILE"
    echo "Server started successfully (PID: $(cat $PID_FILE))"
    echo "Visit: http://localhost:$PORT"
}

stop_server() {
    if [ ! -f "$PID_FILE" ]; then
        echo "Server is not running (no PID file found)"
        return 1
    fi

    PID=$(cat "$PID_FILE")
    if ps -p $PID > /dev/null 2>&1; then
        echo "Stopping server (PID: $PID)..."
        kill $PID
        rm "$PID_FILE"
        echo "Server stopped successfully"
    else
        echo "Server is not running (PID $PID not found)"
        rm "$PID_FILE"
    fi
}

server_status() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Server is running on port $PORT (PID: $PID)"
            echo "Visit: http://localhost:$PORT"
        else
            echo "Server is not running (stale PID file)"
            rm "$PID_FILE"
        fi
    else
        echo "Server is not running"
    fi
}

case "$1" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    restart)
        stop_server
        sleep 1
        start_server
        ;;
    status)
        server_status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
